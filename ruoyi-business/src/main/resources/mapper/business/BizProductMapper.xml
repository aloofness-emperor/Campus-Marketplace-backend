<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.BizProductMapper">

    <resultMap type="BizProduct" id="BizProductResult">
        <id     property="id"            column="id"             />
        <result property="sellerId"      column="seller_id"      />
        <result property="categoryId"    column="category_id"    />
        <result property="campusId"      column="campus_id"      />
        <result property="title"         column="title"          />
        <result property="description"   column="description"    />
        <result property="price"         column="price"          />
        <result property="originalPrice" column="original_price" />
        <result property="images"        column="images"         />
        <result property="quality"       column="quality"        />
        <result property="tradeType"     column="trade_type"     />
        <result property="status"        column="status"         />
        <result property="viewCount"     column="view_count"     />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="campusName"    column="campus_name"    />
        <result property="categoryName"  column="category_name"  />
    </resultMap>

    <sql id="selectBizProductVo">
        select p.id, p.seller_id, p.category_id, p.campus_id, p.title, p.description,
               p.price, p.original_price, p.images, p.quality, p.trade_type, p.status,
               p.view_count, p.create_by, p.create_time, p.update_by, p.update_time,
               p.remark, p.del_flag,
               c.name as campus_name,
               pc.name as category_name
        from biz_product p
        left join biz_campus c on c.id = p.campus_id
        left join biz_product_category pc on pc.id = p.category_id
    </sql>

    <select id="selectBizProductList" parameterType="BizProduct" resultMap="BizProductResult">
        <include refid="selectBizProductVo"/>
        where p.del_flag = 0
        <if test="title != null and title != ''">
            and p.title like concat('%', #{title}, '%')
        </if>
        <if test="campusId != null">
            and p.campus_id = #{campusId}
        </if>
        <if test="categoryId != null">
            and p.category_id = #{categoryId}
        </if>
        <if test="sellerId != null">
            and p.seller_id = #{sellerId}
        </if>
        <if test="quality != null">
            and p.quality = #{quality}
        </if>
        <if test="tradeType != null">
            and p.trade_type = #{tradeType}
        </if>
        <if test="status != null">
            and p.status = #{status}
        </if>
        order by p.create_time desc, p.id desc
    </select>

    <select id="selectBizProductById" parameterType="Long" resultMap="BizProductResult">
        <include refid="selectBizProductVo"/>
        where p.id = #{id} and p.del_flag = 0
    </select>

    <insert id="insertBizProduct" parameterType="BizProduct" useGeneratedKeys="true" keyProperty="id">
        insert into biz_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sellerId != null">seller_id,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="campusId != null">campus_id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="description != null">description,</if>
            <if test="price != null">price,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="images != null">images,</if>
            <if test="quality != null">quality,</if>
            <if test="tradeType != null">trade_type,</if>
            <if test="status != null">status,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sellerId != null">#{sellerId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="campusId != null">#{campusId},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="description != null">#{description},</if>
            <if test="price != null">#{price},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="images != null">#{images},</if>
            <if test="quality != null">#{quality},</if>
            <if test="tradeType != null">#{tradeType},</if>
            <if test="status != null">#{status},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateBizProduct" parameterType="BizProduct">
        update biz_product
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="campusId != null">campus_id = #{campusId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="price != null">price = #{price},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="images != null">images = #{images},</if>
            <if test="quality != null">quality = #{quality},</if>
            <if test="tradeType != null">trade_type = #{tradeType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id} and del_flag = 0
    </update>

    <update id="deleteBizProductById">
        update biz_product
        set del_flag = 1, update_time = sysdate(), update_by = #{updateBy}
        where id = #{id} and del_flag = 0
    </update>

    <update id="deleteBizProductByIds">
        update biz_product
        set del_flag = 1, update_time = sysdate(), update_by = #{updateBy}
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        and del_flag = 0
    </update>
</mapper>
